    "paths": {
        "/auth/register-tenant": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Registrasi Tenant Baru & Akun Owner",
                "description": "Register a new Tenant and its initial Owner account.",
                "operationId": "b7991f021cadad930158500b38821d1a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "tenant_name",
                                    "tenant_slug",
                                    "owner_name",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "tenant_name": {
                                        "type": "string",
                                        "example": "Berkah Catering Nusantara"
                                    },
                                    "tenant_slug": {
                                        "type": "string",
                                        "example": "berkah-catering"
                                    },
                                    "owner_name": {
                                        "type": "string",
                                        "example": "Ahmad Fauzi"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "ahmad@catering.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "081234567890"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Tenant dan akun owner berhasil didaftarkan",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Tenant dan akun owner berhasil didaftarkan."
                                        },
                                        "data": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validasi form gagal"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login User & Dapatkan Bearer Token",
                "description": "Authenticate a user and return access token.",
                "operationId": "985cd5203e2d0a820e113f2f4fdb2847",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "ahmad@catering.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "tenant_slug": {
                                        "type": "string",
                                        "example": "berkah-catering"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login berhasil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Login berhasil."
                                        },
                                        "data": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Kredensial tidak valid"
                    },
                    "403": {
                        "description": "Tidak memiliki akses ke tenant ini"
                    }
                }
            }
        },
