                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Berkah Catering Nusantara"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "081234567890"
